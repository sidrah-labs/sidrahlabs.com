<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ meta.title }}</title>
    <meta name="description" content="{{ meta.description }}" />
    <meta name="theme-color" content="{{ meta.theme_color }}" />
    <link rel="canonical" href="{{ meta.canonical }}" />

    <!-- OpenGraph / Metadata -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="{{ meta.title }}" />
    <meta property="og:description" content="{{ meta.description }}" />
    <meta property="og:url" content="{{ meta.canonical }}" />
    <meta property="og:image" content="{{ meta.og_image }}" />
    <meta name="twitter:card" content="summary" />

    <!-- Minimal SVG Monogram Favicon -->
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23111111'/%3E%3Ctext x='16' y='21' fill='%23ffffff' font-family='monospace' font-size='14' font-weight='bold' text-anchor='middle'%3ES/L%3C/text%3E%3C/svg%3E"
    />

    <link rel="stylesheet" href="/styles.css" />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "ProfessionalService",
        "name": "Sidrah Labs",
        "url": {{ meta.canonical | tojson }},
        "description": {{ meta.description | tojson }},
        "email": {{ contact.email | tojson }},
        "sameAs": [
          "https://github.com/sidrah-labs",
          "https://www.linkedin.com/company/sidrah-labs"
        ]
      }
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to main content</a>

    <header class="masthead">
      <div class="wrap masthead-inner">
        <a class="brand" href="/" aria-label="Sidrah Labs homepage">
          <span class="brand-name">SIDRAH LABS</span>
          <span class="brand-sub">/ SYSTEMS &amp; VERIFICATION</span>
        </a>
        <nav class="nav" aria-label="Site navigation">
          {% for item in nav %}
          <a href="{{ item.href }}">{{ item.label }}</a>
          {% endfor %}
        </nav>
        <a class="btn-discovery" href="{{ contact.href }}">Discovery Call &rarr;</a>
      </div>
    </header>

    <main id="main">
      <!-- Hero Section -->
      <section class="wrap hero-section" aria-labelledby="hero-heading">
        <div class="hero-kicker">APPLIED SYSTEMS &bull; PRODUCTION SERVICES &bull; FORMAL VERIFICATION</div>
        <h1 id="hero-heading" class="hero-title">{{ hero.headline }}</h1>
        <p class="hero-lead">{{ hero.sub }}</p>
        
        <div class="hero-action-bar">
          <a class="btn-primary" href="{{ contact.href }}">Scope an Engagement &rarr;</a>
          <span class="direct-contact">or email directly: <a href="mailto:{{ contact.email }}">{{ contact.email }}</a></span>
        </div>

        <!-- The Thesis Model (Services -> Software -> Research) -->
        <div class="thesis-matrix" role="region" aria-label="Operating Model">
          <div class="matrix-banner">
            <span class="mono-label">OPERATING THESIS</span>
            <span class="matrix-summary">{{ hero.thesis }}</span>
          </div>
          <div class="matrix-grid">
            {% for pillar in thesis_pillars %}
            <div class="matrix-col">
              <div class="col-head">
                <span class="col-id">{{ pillar.id }}</span>
                <span class="col-name">{{ pillar.name }}</span>
              </div>
              <h3 class="col-role">{{ pillar.role }}</h3>
              <p class="col-desc">{{ pillar.desc }}</p>
            </div>
            {% endfor %}
          </div>
        </div>
      </section>

      <!-- Section 01: Engagements -->
      <section id="engagements" class="wrap content-section" aria-labelledby="engagements-heading">
        <div class="section-title-bar">
          <span class="sec-num">{{ engagements.section_id }}</span>
          <h2 id="engagements-heading">{{ engagements.title }}</h2>
        </div>

        <div class="engagements-list">
          {% for eng in engagements.entries %}
          <article class="eng-row">
            <div class="eng-meta">
              <span class="eng-code">{{ eng.code }}</span>
              <span class="eng-dur">{{ eng.duration }}</span>
            </div>
            <div class="eng-main">
              <h3 class="eng-title">{{ eng.name }}</h3>
              <p class="eng-desc">{{ eng.desc }}</p>
              <ul class="eng-deliverables">
                {% for d in eng.deliverables %}
                <li>&bull; {{ d }}</li>
                {% endfor %}
              </ul>
            </div>
          </article>
          {% endfor %}
        </div>
        <p class="section-footnote">{{ engagements.note }}</p>
      </section>

      <!-- Section 02: Toolchain -->
      <section id="toolchain" class="wrap content-section" aria-labelledby="toolchain-heading">
        <div class="section-title-bar">
          <span class="sec-num">{{ toolchain.section_id }}</span>
          <h2 id="toolchain-heading">{{ toolchain.title }}</h2>
        </div>
        <p class="section-subtext">{{ toolchain.desc }}</p>

        <div class="toolchain-grid">
          {% for mod in toolchain.modules %}
          <div class="tool-card">
            <span class="tool-tag">{{ mod.mono_tag }}</span>
            <h3 class="tool-title">{{ mod.title }}</h3>
            <p class="tool-desc">{{ mod.details }}</p>
          </div>
          {% endfor %}
        </div>
      </section>

      <!-- Section 03: Research -->
      <section id="research" class="wrap content-section" aria-labelledby="research-heading">
        <div class="section-title-bar">
          <span class="sec-num">{{ research.section_id }}</span>
          <h2 id="research-heading">{{ research.title }}</h2>
        </div>

        <div class="research-layout">
          <div class="research-left">
            <p class="research-premise">{{ research.premise }}</p>
            <p class="research-body">{{ research.body }}</p>
            <a class="research-link" href="{{ research.github_url }}" target="_blank" rel="noopener noreferrer">
              View open-source research on GitHub &rarr;
            </a>
          </div>
          <div class="research-right">
            <div class="flywheel-box">
              <span class="flywheel-header">THE COMPOUNDING FLYWHEEL</span>
              <p class="flywheel-text">{{ research.flywheel }}</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 04: Field Notes -->
      <section id="field-notes" class="wrap content-section" aria-labelledby="notes-heading">
        <div class="section-title-bar">
          <span class="sec-num">{{ field_notes.section_id }}</span>
          <h2 id="notes-heading">{{ field_notes.title }}</h2>
        </div>

        <div class="notes-table">
          {% for note in field_notes.entries %}
          <div class="note-row">
            <div class="note-metric">{{ note.metric }}</div>
            <div class="note-info">
              <h3 class="note-title">{{ note.title }}</h3>
              <span class="note-client">{{ note.client }}</span>
              <p class="note-summary">{{ note.summary }}</p>
            </div>
          </div>
          {% endfor %}
        </div>
      </section>

      <!-- Closing Callout -->
      <section class="wrap closing-section">
        <div class="closing-card">
          <h2>{{ closing.title }}</h2>
          <p>{{ closing.desc }}</p>
          <div class="closing-actions">
            <a class="btn-primary" href="{{ contact.href }}">Discuss a Fixed-Scope Sprint &rarr;</a>
            <span class="closing-email">{{ contact.email }}</span>
          </div>
        </div>
      </section>
    </main>

    <!-- Minimalist Technical Footer -->
    <footer class="footer">
      <div class="wrap footer-inner">
        <div class="footer-left">
          <span>{{ footer.note }}</span>
        </div>
        <div class="footer-links">
          {% for link in footer.links %}
          <a href="{{ link.url }}" {% if link.url.startswith('http') %}target="_blank" rel="noopener noreferrer"{% endif %}>
            {{ link.label }}
          </a>
          {% endfor %}
        </div>
      </div>
    </footer>
  </body>
</html>
