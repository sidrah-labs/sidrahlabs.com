<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ meta.title }}</title>
    <meta name="description" content="{{ meta.description }}" />
    <meta name="theme-color" content="{{ meta.theme_color }}" />
    <link rel="canonical" href="{{ meta.canonical }}" />

    <meta property="og:type" content="{{ meta.og.type }}" />
    <meta property="og:title" content="{{ meta.og.title }}" />
    <meta property="og:description" content="{{ meta.og.description }}" />
    <meta property="og:url" content="{{ meta.og.url }}" />
    <meta property="og:image" content="{{ meta.og.image }}" />
    <meta name="twitter:card" content="{{ meta.twitter.card }}" />
    <meta name="twitter:title" content="{{ meta.twitter.title }}" />
    <meta name="twitter:description" content="{{ meta.twitter.description }}" />

    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%230d0f12'/%3E%3Ctext x='16' y='21.5' fill='%23ffffff' font-family='Space Grotesk,system-ui,sans-serif' font-size='14' font-weight='700' letter-spacing='-0.5' text-anchor='middle'%3ESL%3C/text%3E%3C/svg%3E"
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/styles.css" />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "ProfessionalService",
        "name": "Sidrah Labs",
        "url": "{{ meta.canonical }}",
        "description": "{{ meta.description }}",
        "founder": {
          "@type": "Person",
          "name": "Muhammad Azeem",
          "email": "{{ hero.cta.email }}"
        },
        "sameAs": [
          "https://github.com/sidrah-labs",
          "https://www.linkedin.com/company/sidrah-labs"
        ]
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="wrap header-inner">
        <a class="wordmark" href="#top" aria-label="{{ nav.wordmark_left }} {{ nav.wordmark_right }}, home">
          <span class="wm-mark" aria-hidden="true"></span>
          <span class="wm-primary">{{ nav.wordmark_left }}</span>
          <span class="wm-sep" aria-hidden="true">/</span>
          <span class="wm-secondary">{{ nav.wordmark_right }}</span>
        </a>
        <nav class="nav" aria-label="Main">
          {% for link in nav.links %}
          <a href="{{ link.href }}">{{ link.label }}</a>
          {% endfor %}
          <a class="nav-cta" href="{{ nav.contact.href }}">{{ nav.contact.label }} &rarr;</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <!-- Hero -->
      <section id="top" class="hero">
        <div class="wrap">
          <p class="eyebrow">{{ hero.eyebrow }}</p>
          <h1>
            {{ hero.headline_prefix }}<span class="headline-em">{{ hero.headline_accent }}</span>{{ hero.headline_suffix }}
          </h1>
          <p class="hero-body">{{ hero.body | trim }}</p>
          <div class="hero-actions">
            <a class="button" href="{{ hero.cta.href }}">{{ hero.cta.label }} &rarr;</a>
            <a class="text-link" href="mailto:{{ hero.cta.email }}">{{ hero.cta.email }}</a>
          </div>
          <p class="hero-meta">{{ hero.meta_index }}</p>
        </div>
      </section>

      <!-- 01: Business Thesis / Why initiatives stall -->
      <section id="thesis" class="section">
        <div class="wrap grid">
          <p class="label">{{ thesis.kicker_label }}</p>
          <div>
            <h2>{{ thesis.title }}</h2>
            <p class="intro">{{ thesis.lead | trim }}</p>
            <ol class="rows">
              {% for pt in thesis.points %}
              <li class="row">
                <p class="row-meta">{{ pt.number }}</p>
                <div>
                  <h3>{{ pt.title }}</h3>
                  <p>{{ pt.description }}</p>
                </div>
              </li>
              {% endfor %}
            </ol>
          </div>
        </div>
      </section>

      <!-- 02: Commercial Sprints (Services-as-Software) -->
      <section id="deployments" class="section">
        <div class="wrap grid">
          <p class="label">{{ deployments.kicker_label }}</p>
          <div>
            <h2>{{ deployments.title }}</h2>
            <p class="intro">{{ deployments.intro | trim }}</p>
            <ol class="rows">
              {% for card in deployments.cards %}
              <li class="row">
                <div class="row-meta-stack">
                  <span class="meta-code">{{ card.code }}</span>
                  <span class="meta-duration">{{ card.duration }}</span>
                </div>
                <div>
                  <h3>{{ card.title }}</h3>
                  <p class="row-outcome">{{ card.outcome }}</p>
                  <p>{{ card.description | trim }}</p>
                  <p class="focus">{{ card.focus }}</p>
                </div>
              </li>
              {% endfor %}
            </ol>
            <p class="note">{{ deployments.scope_note }}</p>
          </div>
        </div>
      </section>

      <!-- 03: Field Evidence (Production & Research Proof) -->
      <section id="proof" class="section">
        <div class="wrap grid">
          <p class="label">{{ proof.kicker_label }}</p>
          <div>
            <h2>{{ proof.title }}</h2>
            <p class="intro">{{ proof.intro | trim }}</p>
            <ol class="rows">
              {% for entry in proof.entries %}
              <li class="row">
                <p class="row-meta">{{ entry.tag }}</p>
                <div>
                  <h3>{{ entry.title }}</h3>
                  <p>{{ entry.description }}</p>
                </div>
              </li>
              {% endfor %}
            </ol>
          </div>
        </div>
      </section>

      <!-- 04: The Applied Lab Model (How we execute) -->
      <section id="method" class="section">
        <div class="wrap grid">
          <p class="label">{{ method.kicker_label }}</p>
          <div>
            <h2>{{ method.title }}</h2>
            <p class="intro">{{ method.intro | trim }}</p>
            <ol class="rows">
              {% for p in method.pillars %}
              <li class="row">
                <p class="row-meta">{{ p.number }}</p>
                <div>
                  <h3>{{ p.title }}</h3>
                  <p>{{ p.description }}</p>
                </div>
              </li>
              {% endfor %}
            </ol>

            <div class="sub-block">
              <p class="sub-label">{{ architecture.kicker_label }} — {{ architecture.title }}</p>
              <ol class="steps">
                {% for step in architecture.diagram_steps %}
                <li>
                  <p class="step-tag">{{ step.id }} · {{ step.tag }}</p>
                  <h3>{{ step.title }}</h3>
                  <p>{{ step.desc }}</p>
                </li>
                {% endfor %}
              </ol>
            </div>
          </div>
        </div>
      </section>

      <!-- 05: In-House Research Moat -->
      <section id="research" class="section">
        <div class="wrap grid">
          <p class="label">{{ research.kicker_label }}</p>
          <div class="prose">
            <h2>{{ research.title }}</h2>
            <p class="lead">{{ research.lead | trim }}</p>
            <p>{{ research.body | trim }}</p>
            <p class="flywheel">{{ research.boundary_note | trim }}</p>
            <p class="prose-link">
              <a class="text-link" href="{{ research.github_link.href }}" target="_blank" rel="noopener noreferrer">{{ research.github_link.label }} &#8599;</a>
            </p>
          </div>
        </div>
      </section>

      <!-- Contact / Discovery -->
      <section id="contact" class="section contact">
        <div class="wrap grid">
          <p class="label">Discovery</p>
          <div>
            <h2 class="contact-title">{{ contact.title }}</h2>
            <p class="intro">{{ contact.body | trim }}</p>
            <div class="hero-actions">
              <a class="button" href="{{ hero.cta.href }}">{{ hero.cta.label }} &rarr;</a>
              <a class="text-link" href="mailto:{{ hero.cta.email }}">{{ hero.cta.email }}</a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="wrap footer-inner">
        <div class="footer-brand">
          <span class="wordmark wordmark-footer">
            <span class="wm-mark" aria-hidden="true"></span>
            <span class="wm-primary">{{ nav.wordmark_left }}</span>
            <span class="wm-sep" aria-hidden="true">/</span>
            <span class="wm-secondary">{{ nav.wordmark_right }}</span>
          </span>
          <span class="footer-tagline">{{ footer.tagline }}</span>
        </div>
        <nav aria-label="Footer">
          {% for link in footer.links %}
          <a href="{{ link.href }}"{% if link.href.startswith('http') %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ link.label }}</a>
          {% endfor %}
        </nav>
      </div>
    </footer>
  </body>
</html>
